@misc{hassanizadeh_discrete_2024,
	title = {Discrete {Event} {Simulation} for {Truck} {Waiting} {Time} at a {Grain} {Elevator}},
	url = {https://www.ssrn.com/abstract=4943169},
	doi = {10.2139/ssrn.4943169},
	abstract = {This study develops the Grain Elevator Heuristic Scheduler (GEHS) algorithm, a discrete-event simulation model, to assess the impact of various operational strategies on truck waiting times at cooperative grain elevators. By applying five distinct strategies across different facility configurations and levels of improvement, the research delineates the most effective approaches to reduce waiting times significantly. The analysis reveals that while a combination of strategies is necessary to notably decrease waiting times at single dump pit elevators, accelerating the grading system alone markedly enhances efficiency in two-pit setups. Additionally, a time and motion study was conducted to validate the simulation assumptions, providing empirical support for the model. Further sensitivity analysis evaluates the effectiveness of each strategy based on truck throughput, offering strategic insights for optimizing agricultural logistics. These findings provide actionable recommendations for cooperative managers to improve operational efficiency, ultimately benefiting cooperative members.},
	language = {en},
	urldate = {2026-08-27},
	author = {Hassanizadeh, Behnam and Kenkel, Phil},
	year = {2024},
	file = {Hassanizadeh and Kenkel - 2024 - Discrete Event Simulation for Truck Waiting Time a.pdf:C\:\\Users\\willi\\Zotero\\storage\\LF658Y2Z\\Hassanizadeh and Kenkel - 2024 - Discrete Event Simulation for Truck Waiting Time a.pdf:application/pdf},
}

@article{r_berruto_analyzing_2001,
	title = {{ANALYZING} {THE} {RECEIVING} {OPERATION} {OF} {DIFFERENT} {GRAIN} {TYPES} {IN} {A} {SINGLEPIT} {COUNTRY} {ELEVATOR}},
