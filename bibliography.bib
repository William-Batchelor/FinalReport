	doi = {10.13031/2013.6090},
	abstract = {With the rise of value–added grains and oilseeds, many elevators need to segregate their incoming products into batches of different end–use quality (for example, high oil corn, genetically modified soybeans, high protein wheat), but often they are not designed to handle this task efficiently. The primary challenge is to segregate multiple grain streams during the receiving operation without increasing waiting times for all customers.},
